rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn() && request.auth.token.email == 'sjm4104@gmail.com';
    }
    function isGoogleUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isTeacher();
    }
    match /projects/{projectId}/likes/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.projectId == projectId
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isTeacher() || (signedIn() && userId == request.auth.uid);
      allow update: if false;
    }
    match /projectStats/{projectId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['views', 'updatedAt'])
        && request.resource.data.views == 1
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/projectStats/$(projectId)/visitors/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/projectStats/$(projectId)/visitors/$(request.auth.uid)).data.lastRecorded == request.time;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'updatedAt'])
        && request.resource.data.views == resource.data.views + 1
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/projectStats/$(projectId)/visitors/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/projectStats/$(projectId)/visitors/$(request.auth.uid)).data.lastRecorded == request.time;
      allow delete: if isTeacher();

      match /visitors/{userId} {
        allow read: if signedIn() && userId == request.auth.uid;
        allow create: if signedIn() && userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['lastRecorded'])
          && request.resource.data.lastRecorded == request.time;
        allow update: if signedIn() && userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastRecorded'])
          && request.resource.data.lastRecorded == request.time
          && request.time - resource.data.lastRecorded >= duration.value(10, 'm');
        allow delete: if isTeacher();
      }
    }
    match /feedback/{feedbackId} {
      allow read: if isTeacher() || resource.data.status == 'published';
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.projectId is string
        && request.resource.data.type in ['question', 'guestbook']
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 20;
      allow update, delete: if isTeacher();
    }
    match /siteFeedback/{feedbackId} {
      allow read: if isTeacher() || resource.data.status == 'published';
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['impression', 'suggestion', 'question']
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 20;
      allow update, delete: if isTeacher();
    }
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isTeacher();
    }
    match /siteStats/overview {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['totalViews', 'dailyViews', 'dateKey', 'updatedAt'])
        && request.resource.data.totalViews == 1
        && request.resource.data.dailyViews == 1
        && request.resource.data.dateKey is string
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/siteVisitors/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/siteVisitors/$(request.auth.uid)).data.lastRecorded == request.time;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalViews', 'dailyViews', 'dateKey', 'updatedAt'])
        && request.resource.data.totalViews == resource.data.totalViews + 1
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/siteVisitors/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/siteVisitors/$(request.auth.uid)).data.lastRecorded == request.time
        && ((request.resource.data.dateKey == resource.data.dateKey
          && request.resource.data.dailyViews == resource.data.dailyViews + 1)
          || (request.resource.data.dateKey != resource.data.dateKey
            && request.resource.data.dailyViews == 1));
      allow delete: if isTeacher();
    }
    match /siteVisitors/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow create: if signedIn() && userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['lastRecorded'])
        && request.resource.data.lastRecorded == request.time;
      allow update: if signedIn() && userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastRecorded'])
        && request.resource.data.lastRecorded == request.time
        && request.time - resource.data.lastRecorded >= duration.value(15, 'm');
      allow delete: if isTeacher();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
